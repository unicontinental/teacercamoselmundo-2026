---
// Versión del globo pensada para incrustarse vía <iframe> dentro de otras
// páginas (p. ej. ruta-internacional). No usa el Layout del sitio, por lo que
// no incluye header/footer ni el botón flotante de WhatsApp. Dentro del iframe,
// `window` equivale al tamaño del mapa, así que toda la lógica de proyección y
// hit-testing del globo funciona sin modificaciones.
import GlobeScene from "../components/GlobeScene.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mapa interactivo UC</title>
        <meta name="robots" content="noindex" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700&family=Inter:wght@300;400;500;600;700&family=Rajdhani:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <GlobeScene showInscripciones={false} />
    </body>
</html>
