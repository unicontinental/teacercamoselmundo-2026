---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Página no encontrada | Te Acercamos el Mundo"
    description="La página que buscas no existe o fue movida."
    noindex
>
    <section class="bg-experiencias bg-cover bg-center">
        <div class="max-w-7xl mx-auto px-4 md:px-5 py-24 md:py-36 text-center text-white">
            <p class="font-wideBold text-6xl md:text-8xl text-dorado">404</p>
            <h1 class="mt-4 font-wideBold text-2xl md:text-4xl uppercase">Página no encontrada</h1>
            <p class="mt-4 text-base md:text-lg max-w-xl mx-auto">
                La página que buscas no existe o fue movida. Sigue explorando tu futuro internacional.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
                <a href="/" class="rounded-full bg-purpura px-6 py-3 font-bold hover:bg-morado transition-colors">Ir al inicio</a>
                <a href="/ruta-internacional/" class="rounded-full border border-white px-6 py-3 hover:bg-white/10 transition-colors">Ruta Internacional</a>
            </div>
        </div>
    </section>
</Layout>
