---
import "../styles/mapa-mundo-uc.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Universidad Continental – Mapa Mundial UC</title>
        <meta
            name="description"
            content="Explora en un globo interactivo las universidades e instituciones asociadas a la Universidad Continental alrededor del mundo."
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700&family=Inter:wght@300;400;500;600;700&family=Rajdhani:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div id="app">
            <canvas id="globe-canvas"></canvas>

            <!-- SVG layer for connection lines -->
            <svg id="lines-svg" xmlns="http://www.w3.org/2000/svg"></svg>

            <!-- HTML overlay for labels and nodes -->
            <div id="overlay">
                <!-- Flag nodes (positioned dynamically) -->
                <div id="flag-nodes"></div>

                <!-- University labels -->
                <div id="labels"></div>

                <!-- ══ LEFT SECTION: logo + title + subtitle ══════════════════════ -->
                <div id="left-hero">
                    <img
                        class="lh-logo"
                        src="/images/uc-logo.png"
                        alt="Universidad Continental"
                    />
                    <h1 class="lh-title">CONVENIOS<br />INTERNACIONALES</h1>
                    <p class="lh-subtitle">
                        Explora oportunidades globales de educación
                    </p>
                </div>

                <!-- ══ RIGHT SECTION — top: hint panel ════════════════════════════ -->
                <div id="hint-panel">
                    <span class="hint-icon">💡</span>
                    <p class="hint-text">
                        Haz clic en los marcadores del globo para explorar
                        nuestras instituciones asociadas por país.
                    </p>
                </div>

                <!-- ══ RIGHT SECTION — bottom: inscripciones abiertas ════════════ -->
                <div id="inscripciones-card">
                    <div class="ic-badge">
                        <span>¡INSCRIPCIONES</span>
                        <span>ABIERTAS!</span>
                    </div>
                    <button class="ic-btn">Haz clic aquí</button>
                </div>

                <!-- ══ FOOTER NAV — pill navigation buttons ══════════════════════ -->
                <div id="footer-nav">
                    <button
                        class="fn-btn fn-prev"
                        id="fn-prev"
                        aria-label="País anterior">&#8249;</button
                    >
                    <button
                        class="fn-btn fn-next"
                        id="fn-next"
                        aria-label="País siguiente">&#8250;</button
                    >
                </div>

                <!-- Backdrop -->
                <div id="panel-backdrop"></div>

                <!-- Country detail panel -->
                <div id="country-panel" aria-hidden="true">
                    <button class="cp-close" id="cp-close" aria-label="Cerrar"
                        >✕</button
                    >

                    <div class="cp-header">
                        <img class="cp-photo" id="cp-photo" src="" alt="" />
                        <div class="cp-header-grad"></div>
                        <div class="cp-header-content">
                            <img class="cp-flag" id="cp-flag" src="" alt="" />
                            <div class="cp-country-name" id="cp-country-name">
                            </div>
                        </div>
                    </div>

                    <div class="cp-info-bar">
                        <span class="cp-info-item">
                            <span class="cp-info-label">Programas:</span>
                            <span id="cp-programs"></span>
                        </span>
                        <span class="cp-info-sep">·</span>
                        <span class="cp-info-item">
                            <span class="cp-info-label">Instituciones:</span>
                            <span id="cp-institutions"></span>
                        </span>
                        <span class="cp-info-sep">·</span>
                        <span class="cp-info-item">
                            <span class="cp-info-label">Ciudades:</span>
                            <span id="cp-cities"></span>
                        </span>
                    </div>

                    <div class="cp-body">
                        <div class="cp-section-label">
                            UNIVERSIDADES CON CONVENIO
                        </div>
                        <div class="cp-accordion" id="cp-accordion"></div>
                    </div>

                    <div class="cp-footer">
                        <button
                            class="cp-nav-btn"
                            id="cp-prev"
                            aria-label="País anterior">&#8249;</button
                        >
                        <div class="cp-pager">
                            <span class="cp-pager-count" id="cp-pager-count"
                                >1 / 8</span
                            >
                            <div class="cp-dots" id="cp-dots"></div>
                        </div>
                        <button
                            class="cp-nav-btn"
                            id="cp-next"
                            aria-label="País siguiente">&#8250;</button
                        >
                    </div>
                </div>
            </div>
        </div>

        <script>
            import "../scripts/mapa-mundo-uc/main.js";
        </script>
    </body>
</html>
