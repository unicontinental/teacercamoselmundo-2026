---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import coverCv from "../../assets/cover-cv.jpg";
import coverLinkedin from "../../assets/cover-linkedin.jpg";
import coverEntrevista from "../../assets/cover-entrevista.jpg";
import coverTiempo from "../../assets/cover-tiempo.jpg";
import coverConvocatorias from "../../assets/cover-convocatorias.jpg";

// Covers de video (verticales 9:16). El título ya viene horneado en el cover.
// videoId: ID del Short de YouTube (embebido en el modal).
const videos = [
    {
        cover: coverCv,
        title: "Tips para mejorar tu CV",
        videoId: "YarhnZS9lPk",
        description: "Descubre 3 consejos clave para transformar tu CV en una herramienta más atractiva y alineada a oportunidades internacionales.",
    },
    {
        cover: coverLinkedin,
        title: "¿Cómo armar un LinkedIn atractivo?",
        videoId: "5UhdMxN5qDE",
        description: "Aprende los tips básicos para construir un perfil de LinkedIn más profesional y atractivo.",
    },
    {
        cover: coverEntrevista,
        title: "¿Cómo destacar en una entrevista laboral?",
        videoId: "EGV_TRzLzE4",
        description: "Conoce los tips claves para potenciar tu propuesta de valor y asegurar tu próximo empleo.",
    },
    {
        cover: coverTiempo,
        title: "Herramientas para organizar tu tiempo",
        videoId: "kIkqP9OZTn4",
        description: "Descubre cómo crear tu propio sistema de organización para mejorar tu rendimiento académico.",
    },
    {
        cover: coverConvocatorias,
        title: "Tips para postular a convocatorias internacionales",
        videoId: "NU4sNiAJ4Rg",
        description: "Aprende los 5 tips esenciales para preparar tu postulación y dar el primer paso hacia tu intercambio.",
    },
];
---

<Layout>
    <SectionTitle title="Tu puente al mundo" />
    <section class="bg-white">
        <div class="max-w-7xl mx-auto px-4 md:px-5 pt-12 md:pt-16">
            <p class="text-center text-base md:text-lg max-w-3xl mx-auto leading-relaxed">
                <strong>Videos con herramientas y experiencias</strong> para potenciar tu CV,
                aprender idiomas y prepararte para oportunidades internacionales.
            </p>
        </div>

        <div class="max-w-7xl mx-auto px-4 md:px-5 py-12 md:py-16">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                {videos.map((video) => (
                    <div x-data={`videoModal('${video.videoId}')`} class="w-full">
                        <button
                            type="button"
                            class="group relative block w-full aspect-350/438 cursor-pointer overflow-hidden rounded-xl"
                            @click="open()"
                            aria-haspopup="dialog"
                            aria-label={`Reproducir: ${video.title}`}
                        >
                            <Image src={video.cover} alt={video.title} width={1080} height={1920} class="absolute inset-0 h-full w-full object-cover object-top" />
                            <span class="absolute inset-0 flex items-center justify-center">
                                <span class="flex h-14 w-14 items-center justify-center rounded-full bg-purpura shadow-lg transition-transform duration-300 group-hover:scale-110">
                                    <svg class="ml-1 h-6 w-6 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                                </span>
                            </span>
                        </button>
                        <h3 class="mt-3 font-bold text-base md:text-lg text-black">{video.title}</h3>
                        <p class="mt-1 text-sm text-gray-600 leading-snug">{video.description}</p>
                        <div
                            x-show="isOpen"
                            x-cloak
                            x-transition:enter="transition ease-out duration-200"
                            x-transition:enter-start="opacity-0"
                            x-transition:enter-end="opacity-100"
                            x-transition:leave="transition ease-in duration-150"
                            x-transition:leave-start="opacity-100"
                            x-transition:leave-end="opacity-0"
                            class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 px-4"
                            role="dialog"
                            aria-modal="true"
                            @click.self="close()"
                            @keydown.escape.window="close()"
                        >
                            <div class="relative w-full max-w-sm">
                                <button
                                    type="button"
                                    class="absolute -top-10 right-0 text-white cursor-pointer"
                                    @click="close()"
                                    aria-label="Cerrar video"
                                >
                                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6l-12 12" />
                                    </svg>
                                </button>
                                <div class="aspect-9/16 w-full overflow-hidden rounded-xl bg-black">
                                    <iframe
                                        x-ref="iframe"
                                        title={video.title}
                                        class="h-full w-full"
                                        src=""
                                        allow="autoplay; fullscreen; picture-in-picture"
                                        allowfullscreen
                                    ></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>
</Layout>
