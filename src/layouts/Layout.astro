---
import "../styles/tailwind.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Te Acercamos el Mundo | Intercambios y convenios internacionales",
  description = "Descubre programas y convenios académicos, intercambios internacionales y experiencias globales que fortalecen tu perfil. ¡Solicita información ahora!",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://teacercamoselmundo.pe");
// Canonical siempre con barra final (el servidor redirige /ruta → /ruta/) y sin index.html.
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\/?$/, "/");
const canonical = new URL(path, site).href;
const ogImage = new URL("/miniatura.jpg", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `${site.origin}/#organization`,
      name: "Universidad Continental",
      url: "https://ucontinental.edu.pe/",
      logo: new URL("/apple-touch-icon.png", site).href,
      sameAs: ["https://ucontinental.edu.pe/"],
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      name: "Te Acercamos el Mundo",
      url: `${site.origin}/`,
      inLanguage: "es-PE",
      publisher: { "@id": `${site.origin}/#organization` },
    },
  ],
};
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Te Acercamos el Mundo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />

    <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=G-BDRRV0B80Z`}></script>
    {/* gtag global aparte: define:vars envuelve su script en una función y lo dejaría local. */}
    <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    </script>
    <script is:inline define:vars={{ tagmanager: 'G-BDRRV0B80Z' }}>
    gtag('js', new Date());
    gtag('config', tagmanager);
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <a
      href="https://wa.me/51971115546?text=%C2%A1Hola,%20en%20la%20Universidad%20Continental%20te%20acercamos%20el%20mundo!%20Conoce%20nuestras%20carreras%20y%20propuesta%20internacional.%20%3A%29"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-4 right-4 z-20 md:w-42 h-auto w-24 drop-shadow-lg"
      aria-label="WhatsApp"
    >
      <Icon name="wsp" class="h-full w-full wsp-pulse" aria-hidden="true" />
    </a>
    {/* Clic en WhatsApp = lead. Marcar "whatsapp_click" como evento clave en GA4. */}
    <script is:inline>
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href*="wa.me"]');
      if (!link) return;
      gtag('event', 'whatsapp_click', {
        link_url: link.href,
        page_location: location.href,
        transport_type: 'beacon'
      });
    });
    </script>
  </body>
</html>
<style>
  .wsp-pulse {
    transform-origin: center;
    animation: wsp-pulse 2s ease-in-out infinite;
  }

  @keyframes wsp-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }
</style>
