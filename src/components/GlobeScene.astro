---
import "../styles/mapa-mundo-uc.css";

interface Props {
    /** Muestra la tarjeta "¡Inscripciones abiertas!" (oculta en la versión embebida) */
    showInscripciones?: boolean;
}

const { showInscripciones = true } = Astro.props;
---

<div id="app">
    <canvas id="globe-canvas"></canvas>

    <!-- SVG layer for connection lines -->
    <svg id="lines-svg" xmlns="http://www.w3.org/2000/svg"></svg>

    <!-- HTML overlay for labels and nodes -->
    <div id="overlay">
        <!-- Flag nodes (positioned dynamically) -->
        <div id="flag-nodes"></div>

        <!-- University labels -->
        <div id="labels"></div>

        <!-- ══ LEFT SECTION: logo + title + subtitle ══════════════════════ -->
        <div id="left-hero">
            <h1 class="lh-title">EDUCACIÓN<br />DE CALIDAD<br />INTERNACIONAL</h1>
            <p class="lh-subtitle">
                En la Universidad Continental, la educación no es sólo un
                camino, es un mapa con infinitas rutas hacia tus metas.<br /><br
                />Gira el mapamundi y descubre los convenios y oportunidades
                internacionales que tenemos para ti.
            </p>
        </div>

        <!-- ══ RIGHT SECTION — top: hint panel ════════════════════════════ -->
        <div id="hint-panel">
            <span class="hint-icon">💡</span>
            <p class="hint-text">
                Haz clic en los marcadores del globo para explorar nuestras
                instituciones asociadas por país.
            </p>
        </div>

        {
            showInscripciones && (
                <div id="inscripciones-card">
                    <div class="ic-badge">
                        <span>¡INSCRIPCIONES</span>
                        <span>ABIERTAS!</span>
                    </div>
                    <button class="ic-btn">Haz clic aquí</button>
                </div>
            )
        }

        <!-- ══ FOOTER NAV — pill navigation buttons ══════════════════════ -->
        <div id="footer-nav">
            <button class="fn-btn fn-prev" id="fn-prev" aria-label="País anterior"
                >&#8249;</button
            >
            <div class="fn-sep"></div>
            <button
                class="fn-btn fn-globe-toggle is-playing"
                id="globe-toggle"
                aria-label="Pausar rotación"></button
            >
            <div class="fn-sep"></div>
            <button class="fn-btn fn-next" id="fn-next" aria-label="País siguiente"
                >&#8250;</button
            >
        </div>

        <!-- Backdrop -->
        <div id="panel-backdrop"></div>

        <!-- Country detail panel -->
        <div id="country-panel" aria-hidden="true">
            <button class="cp-close" id="cp-close" aria-label="Cerrar">✕</button>

            <div class="cp-header">
                <img class="cp-photo" id="cp-photo" src="" alt="" />
                <div class="cp-header-grad"></div>
                <div class="cp-header-content">
                    <img class="cp-flag" id="cp-flag" src="" alt="" />
                    <div class="cp-country-name" id="cp-country-name"></div>
                </div>
            </div>

            <div class="cp-body">
                <div class="cp-section-label">UNIVERSIDADES CON CONVENIO</div>
                <div class="cp-accordion" id="cp-accordion"></div>
            </div>

            <div class="cp-footer">
                <button class="cp-nav-btn" id="cp-prev" aria-label="País anterior"
                    >&#8249;</button
                >
                <div class="cp-pager">
                    <span class="cp-pager-count" id="cp-pager-count">1 / 8</span>
                    <div class="cp-dots" id="cp-dots"></div>
                </div>
                <button class="cp-nav-btn" id="cp-next" aria-label="País siguiente"
                    >&#8250;</button
                >
            </div>
        </div>
    </div>
</div>

<script>
    import "../scripts/mapa-mundo-uc/main.js";
</script>
