---
import bannerVideo from "../assets/animations/banner.mp4";
import bannerPoster from "../assets/bg-banner.webp";
---
<section class="relative bg-black overflow-hidden">
  <h1 class="sr-only">Te acercamos el mundo — Elige un futuro internacional</h1>
  <video
    class="block w-full h-auto"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={bannerPoster.src}
    aria-label="Te acercamos el mundo. Elige un futuro internacional."
  >
    <source src={bannerVideo} type="video/mp4" />
  </video>
</section>
