---
const { title, as: Tag = "h2" } = Astro.props;
---

<section class="bg-experiencias bg-cover bg-center">
    <div class="max-w-7xl mx-auto px-4 md:px-5 py-16 md:py-24">
        <Tag class="font-wideBold text-2xl md:text-5xl text-center uppercase leading-tight md:leading-18 text-white">
            {title}
        </Tag>
    </div>
</section>
