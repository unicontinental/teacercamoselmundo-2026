---
import { Image } from "astro:assets";
import acercaAlMundo from "../assets/acerca-al-mundo.webp";
import rutaInternacional from "../assets/ruta-internacional.webp";
// import cursos from "../assets/cursos.webp"; // Oculto: tarjeta Cursos Libres deshabilitada
---
<section class="bg-white">
    <div class="max-w-7xl mx-auto px-4 md:px-5 py-16 md:py-20">
        <h2 class="text-2xl md:text-5xl mb-6 md:mb-15 text-center uppercase leading-tight text-[#5A00AA]">
            <span class="font-sans font-normal">¿Qué</span> <span class="font-wideBold">Futuro</span><br />
            <span class="font-wideBold">Internacional</span><br />
            <span class="font-wideBold">Eliges</span> <span class="font-sans font-normal">Hoy?</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 md:gap-8 gap-4 max-w-3xl mx-auto">
            <div class="flex flex-col items-center justify-center max-w-80 mx-auto">
                <a href="/experiencias-globales" class="block group">
                    <Image
                        src={acercaAlMundo}
                        alt="Contenido que te acerca al mundo"
                        width={320}
                        height={320}
                        class={'mb-7 cursor-pointer grayscale group-hover:grayscale-0 transition-all duration-500'}
                    />
                    <div class="bg-black group-hover:bg-purpura font-wideBold w-full text-white text-center py-2 md:text-2xl whitespace-pre-line uppercase mb-5">Tu puente
                        al mundo
                    </div>
                    <p class="text-center text-base md:text-lg leading-relaxed">
                        Una guía de contenido o videos para prepararte para tus próximos pasos internacionales.
                    </p>
                </a>
            </div>
            <div class="flex flex-col items-center justify-center max-w-80 mx-auto">
                <a href="/ruta-internacional" class="block group">
                    <Image
                        src={rutaInternacional}
                        alt="Ruta Internacional"
                        width={320}
                        height={320}
                        class={'mb-7 cursor-pointer grayscale group-hover:grayscale-0 transition-all duration-500'}
                    />
                    <div class="bg-black group-hover:bg-purpura font-wideBold w-full text-white text-center py-2 md:text-2xl whitespace-pre-line uppercase mb-5">Ruta
                        Internacional</div>
                    <p class="text-center text-base md:text-lg leading-relaxed">
                        Explora convenios globales, universidades y destinos que te acercan a nuevas experiencias académicas y oportunidades alrededor del mundo.
                    </p>
                </a>
            </div>
            {/* Oculto temporalmente: tarjeta "Cursos Libres" (página deshabilitada).
            <div class="flex flex-col items-center justify-center max-w-80 mx-auto">
                <a href="/cursos" class="block group">
                    <Image
                        src={cursos}
                        alt="Cursos Libres"
                        width={320}
                        height={320}
                        class={'mb-7 cursor-pointer grayscale group-hover:grayscale-0 transition-all duration-500'}
                    />
                    <div class="bg-black group-hover:bg-purpura font-wideBold w-full text-white text-center py-2 md:text-2xl whitespace-pre-line uppercase mb-5">Cursos
                        Libres</div>
                    <p class="text-center text-base md:text-lg leading-relaxed">
                        Aprende de la mano de expertos sobre las últimas tendencias y desarrolla habilidades transversales para fortalecer tu perfil profesional y futuro laboral .
                    </p>
                </a>
            </div>
            */}
        </div>
    </div>
</section>
